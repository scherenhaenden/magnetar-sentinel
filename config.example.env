# ==============================================================================
# Magnetar Sentinel - Secure Production Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT save real credentials inside the git repository or web folder.
# Copy this file to a secure location outside the web root, for example:
#   sudo mkdir -p /etc/magnetar
#   sudo cp config.example.env /etc/magnetar/magnetar.env
#   sudo chmod 600 /etc/magnetar/magnetar.env
#   sudo chown -R magnetar:magnetar /etc/magnetar
#
# If running with systemd, load via:
#   EnvironmentFile=/etc/magnetar/magnetar.env
# ==============================================================================

# Web Dashboard Authentication
MS_DASHBOARD_USER=admin
MS_DASHBOARD_PASS=ReplaceWithYourSuperSecurePassword123!
MS_PORT=5050

# Database Connection (SQLite, PostgreSQL, MySQL, MariaDB)
# SQLite:
MS_DATABASE_URL=sqlite:////var/lib/magnetar/magnetar.db
# PostgreSQL:
# MS_DATABASE_URL=postgresql://magnetar_user:securepass@127.0.0.1:5432/magnetar_db
# MySQL / MariaDB:
# MS_DATABASE_URL=mysql+pymysql://magnetar_user:securepass@127.0.0.1:3306/magnetar_db

# SSH Log Reader Configuration (If pulling logs remotely from other servers)
MS_SSH_HOST=127.0.0.1
MS_SSH_USER=deploy
MS_SSH_KEY=/home/deploy/.ssh/id_rsa
MS_LOG_DIR=/var/log/nginx

# GeoIP Country Database
MS_GEOIP_DB=/usr/share/GeoIP/GeoLite2-City.mmdb

# Aggregation window (days)
MS_DAYS=7

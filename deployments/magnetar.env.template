# ==============================================================================
# /etc/magnetar/magnetar.env — Plantilla de Configuración en Producción
# ==============================================================================
# Permisos recomendados: chmod 600 /etc/magnetar/magnetar.env (owned by root:root)

# Credenciales del Panel Web
MS_DASHBOARD_USER=admin
MS_DASHBOARD_PASS=GENERA_UNA_CONTRASEÑA_SEGURA_DE_34_CARACTERES
MS_PORT=5050

# Base de datos
MS_DATABASE_URL=sqlite:////home/sc-sentinel/magnetar-sentinel/magnetar.db

# Base de datos de Geolocalización MaxMind
MS_GEOIP_DB=/usr/share/GeoIP/country.mmdb

# Lector de logs (Local o SSH)
MS_SSH_HOST=127.0.0.1
MS_SSH_USER=root
MS_SSH_KEY=/root/.ssh/id_ed25519
MS_LOG_DIR=/home/tu-sitio/logs/nginx
MS_DAYS=7
